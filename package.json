{
  "name": "hearing-simulator",
  "version": "1.0.0",
  "private": true,
  "description": "AI要件定義ハンズオン用の模擬ヒアリング チャットツール",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "personas": "node scripts/build-personas.mjs",
    "predev": "node scripts/build-personas.mjs",
    "dev": "tsx watch --env-file-if-exists=.env src/dev.ts",
    "prestart": "node scripts/build-personas.mjs",
    "start": "tsx --env-file-if-exists=.env src/dev.ts",
    "build": "node scripts/build-personas.mjs && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-personas.mjs && vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/node-server": "^2.1.5",
    "@upstash/redis": "^1.39.0",
    "hono": "^4.13.13",
    "openai": "^7.43.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
