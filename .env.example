# --- AI の提供元 / AI provider -------------------------------------------
# anthropic または openai（ローカルの動作確認だけ mock も使える）
AI_PROVIDER=anthropic

# AI_PROVIDER に合わせて、どちらか一方だけ設定する。値は絶対にコミットしない
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 省略可。省略時は anthropic=claude-opus-5-5 / openai=gpt-6.1-sol
# 安くしたい場合の例: AI_MODEL=claude-sonnet-5-5
AI_MODEL=

# --- 合言葉 / Access codes ------------------------------------------------
# 参加者用（4文字以上）
ACCESS_CODE=
# 講師用（8文字以上、ACCESS_CODE と違うもの）
ADMIN_CODE=

# --- 使える量の上限 / Limits ----------------------------------------------
# 1人・1相手あたりの往復の上限
MAX_TURNS_PER_PERSONA=40
# 1日の入力＋出力トークンの上限。超えたら全員の送信を止める
DAILY_TOKEN_LIMIT=3000000

# --- 保存先 / Storage -----------------------------------------------------
# ローカル実行時のログの書き出し先（Vercel では使われず、Redis に残る）
LOG_DIR=./logs
# 会話・ログの保存期間（日）。ハンズオン後はこの期間で自動的に消える
DATA_TTL_DAYS=14

# Vercel で動かすときに必須。Vercel Marketplace の Upstash Redis を接続すると自動で入る
# （KV_REST_API_URL / KV_REST_API_TOKEN という名前でも可）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- 任意 / Optional ------------------------------------------------------
# 「その日」の区切りに使うタイムゾーン
APP_TIMEZONE=Asia/Tokyo
# Cookie の署名に混ぜる値。省略時は合言葉から導出する
SESSION_SECRET=
# off にすると Claude のサーバー側フォールバック（ベータ）を使わない。ベータ機能でエラーが出る場合に使う
AI_FALLBACK=on
# 概算金額の単価（USD / 100万トークン）。未知のモデルを使うときだけ設定する
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
# ローカル実行時のポート
PORT=3000
